      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 4.3,
      "utterance": "Hello, good morning. This is Arjun from Acme Lending.",
      "start_time": 0.8
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 7.3,
      "utterance": "Yes, tell me.",
      "start_time": 5.7
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 12,
      "utterance": "Could you please confirm your date of birth for verification?",
      "start_time": 8
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 15.3,
      "utterance": "It's the 14th of March, 1986.",
      "start_time": 13.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 18.1,
      "utterance": "Thank you, that's verified.",
      "start_time": 16.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 22.9,
      "utterance": "I'm calling because this month's EMI is still pending.",
      "start_time": 19.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 26.5,
      "utterance": "The amount is ₹8,900 and it's due on 23 October.",
      "start_time": 23.3
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 32.4,
      "utterance": "There were some medical expenses at home this month, so it got delayed.",
      "start_time": 27.7
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 34.6,
      "utterance": "Okay, I understand.",
      "start_time": 33
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 41.3,
      "utterance": "I can send a UPI payment link by SMS, or set up auto-debit so you don't miss the next one.",
      "start_time": 35.3
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 44.2,
      "utterance": "I can pay by Thursday.",
      "start_time": 42.6
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 47,
      "utterance": "Okay.",
      "start_time": 45.4
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 53.5,
      "utterance": "So that's ₹8,900 by Thursday, and the link is on your phone. Anything else I can help with?",
      "start_time": 47.5
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 55.8,
      "utterance": "No, that's all. Thank you.",
      "start_time": 54.1
     }
