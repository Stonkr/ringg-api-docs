    "transcript": [
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 4.3,
      "utterance": "Hello, good morning. This is Arjun from Acme Lending.",
      "start_time": 0.8
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 6.9,
      "utterance": "Yes, tell me.",
      "start_time": 5.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 12.4,
      "utterance": "Before we continue, this call is recorded for quality and training.",
      "start_time": 7.9
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 17,
      "utterance": "Could you please confirm your date of birth for verification?",
      "start_time": 12.9
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 19.2,
      "utterance": "It's the 14th of March, 1986.",
      "start_time": 17.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 21.7,
      "utterance": "Thank you, that's verified.",
      "start_time": 19.9
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 25.6,
      "utterance": "Just a reminder that your EMI is coming up.",
      "start_time": 22.7
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 29.4,
      "utterance": "The amount is ₹13,400 and it's due on 26 October.",
      "start_time": 26.1
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 34.7,
      "utterance": "There were some medical expenses at home this month, so it got delayed.",
      "start_time": 30
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 39.3,
      "utterance": "I'm sorry to hear that, I hope everyone is doing better now.",
      "start_time": 35.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 46.4,
      "utterance": "I can send a UPI payment link by SMS, or set up auto-debit so you don't miss the next one.",
      "start_time": 40.4
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 48.9,
      "utterance": "I can pay by Saturday.",
      "start_time": 47.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 51.1,
      "utterance": "Great, I've noted Saturday.",
      "start_time": 49.3
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 53.5,
      "utterance": "I'll send the link. Thank you.",
      "start_time": 51.5
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 56,
      "utterance": "No, that's all. Thank you.",
      "start_time": 54.2
     }
    ],
