    "transcript": [
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 4.7,
      "utterance": "Good morning Lakshmi ji. This is Vikram from Acme Lending.",
      "start_time": 0.8
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 6.7,
      "utterance": "Yes, tell me.",
      "start_time": 5.1
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 11.4,
      "utterance": "Could you please confirm your date of birth for verification?",
      "start_time": 7.3
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 13.6,
      "utterance": "It's the 14th of March, 1986.",
      "start_time": 11.7
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 16,
      "utterance": "Thank you, that's verified.",
      "start_time": 14.2
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 20.6,
      "utterance": "I'm calling because this month's EMI is still pending.",
      "start_time": 17
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 23.4,
      "utterance": "There is an EMI due on your account.",
      "start_time": 21
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 28.7,
      "utterance": "There were some medical expenses at home this month, so it got delayed.",
      "start_time": 23.9
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 33.9,
      "utterance": "I'm sorry to hear that, I hope everyone is doing better now.",
      "start_time": 29.9
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 40.9,
      "utterance": "I can send a UPI payment link by SMS, or set up auto-debit so you don't miss the next one.",
      "start_time": 34.9
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 43.4,
      "utterance": "I can pay by Saturday.",
      "start_time": 41.8
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 45.5,
      "utterance": "Okay.",
      "start_time": 43.9
     },
     {
      "role": "agent",
      "speaker": "speaker_0",
      "end_time": 52.9,
      "utterance": "So that's ₹4,250 by Saturday, and the link is on your phone. Anything else I can help with?",
      "start_time": 46.9
     },
     {
      "role": "customer",
      "speaker": "speaker_1",
      "end_time": 55.3,
      "utterance": "No, that's all. Thank you.",
      "start_time": 53.5
     }
    ],
