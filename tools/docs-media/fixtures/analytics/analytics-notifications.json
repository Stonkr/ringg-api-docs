    {
     "id": "57cca3be-4bb1-4ba3-8fca-9d74dad25a31",
     "name": "Fatal Classification Alert",
     "subject_template": "FATAL: {{ agent_name }} - {{ interaction_title }}",
     "body_template": "<div style=\"background:#FEE2E2;border-left:4px solid #DC2626;padding:16px;border-radius:8px;margin-bottom:20px\">\n  <h2 style=\"color:#DC2626;margin:0 0 8px\">Fatal Issue Detected</h2>\n  <p style=\"margin:0;color:#333\">A fatal classification was found on an interaction handled by <strong>{{ agent_name }}</strong>.</p>\n</div>\n\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600;width:140px\">Agent</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ agent_name }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Interaction</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ interaction_title }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Type</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ source_type | title }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Score</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\"><strong>{{ overall_score }}/100</strong></td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Severity</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB;color:#DC2626;font-weight:700\">{{ max_severity | upper }}</td>\n  </tr>\n</table>\n\n{% if classifications %}\n<h3 style=\"margin:0 0 8px;color:#333\">Classifications</h3>\n<ul style=\"margin:0 0 20px;padding-left:20px\">\n{% for c in classifications %}\n  <li style=\"margin-bottom:4px\"><strong>{{ c.name }}</strong> — {{ c.severity }} ({{ (c.confidence * 100) | round }}% confidence)</li>\n{% endfor %}\n</ul>\n{% endif %}\n\n{% if summary %}\n<h3 style=\"margin:0 0 8px;color:#333\">Summary</h3>\n<p style=\"margin:0 0 20px;color:#555\">{{ summary }}</p>\n{% endif %}\n\n<a href=\"{{ interaction_url }}\" style=\"display:inline-block;padding:10px 20px;background:#F55F04;color:#fff;text-decoration:none;border-radius:6px;font-weight:600\">View Interaction</a>",
     "description": "Immediate alert when a fatal issue is detected on an interaction.",
     "is_system": true,
     "is_active": true,
     "created_at": "2026-10-22T08:21:52.467212Z",
     "updated_at": null
    },
    {
     "id": "46cb95b1-a51d-4874-a687-bb94f9500983",
     "name": "Low Score Alert",
     "subject_template": "Low Score Alert: {{ agent_name }} scored {{ overall_score }}/100",
     "body_template": "<div style=\"background:#FEF3C7;border-left:4px solid #D97706;padding:16px;border-radius:8px;margin-bottom:20px\">\n  <h2 style=\"color:#D97706;margin:0 0 8px\">Low Score Detected</h2>\n  <p style=\"margin:0;color:#333\"><strong>{{ agent_name }}</strong> scored <strong>{{ overall_score }}/100</strong> on a {{ source_type }}.</p>\n</div>\n\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600;width:140px\">Agent</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ agent_name }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Score</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB;color:#D97706;font-weight:700\">{{ overall_score }}/100</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Type</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ source_type | title }}</td>\n  </tr>\n</table>\n\n{% if summary %}\n<h3 style=\"margin:0 0 8px;color:#333\">Summary</h3>\n<p style=\"margin:0 0 20px;color:#555\">{{ summary }}</p>\n{% endif %}\n\n{% if action_items %}\n<h3 style=\"margin:0 0 8px;color:#333\">Key Events</h3>\n<ul style=\"margin:0 0 20px;padding-left:20px\">\n{% for item in action_items %}\n  <li style=\"margin-bottom:4px\">{{ item }}</li>\n{% endfor %}\n</ul>\n{% endif %}\n\n<a href=\"{{ interaction_url }}\" style=\"display:inline-block;padding:10px 20px;background:#F55F04;color:#fff;text-decoration:none;border-radius:6px;font-weight:600\">View Interaction</a>",
     "description": "Alert when an interaction scores below a threshold.",
     "is_system": true,
     "is_active": true,
     "created_at": "2026-10-22T08:21:52.467212Z",
     "updated_at": null
    },
    {
     "id": "1ae71fd1-b3fd-4abf-b958-d21a58ace536",
     "name": "Classification Summary",
     "subject_template": "Classification Report: {{ interaction_title }}",
     "body_template": "<h2 style=\"margin:0 0 16px;color:#333\">Classification Report</h2>\n\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600;width:140px\">Agent</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ agent_name }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Interaction</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ interaction_title }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Score</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\"><strong>{{ overall_score }}/100</strong></td>\n  </tr>\n</table>\n\n{% if classifications %}\n<h3 style=\"margin:0 0 12px;color:#333\">Classifications Found</h3>\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n  <tr style=\"background:#F9FAFB\">\n    <th style=\"padding:8px 12px;border:1px solid #E5E7EB;text-align:left\">Issue</th>\n    <th style=\"padding:8px 12px;border:1px solid #E5E7EB;text-align:left\">Severity</th>\n    <th style=\"padding:8px 12px;border:1px solid #E5E7EB;text-align:left\">Confidence</th>\n  </tr>\n  {% for c in classifications %}\n  <tr>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ c.name }}</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ c.severity }}</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ (c.confidence * 100) | round }}%</td>\n  </tr>\n  {% endfor %}\n</table>\n{% endif %}\n\n{% if summary %}\n<h3 style=\"margin:0 0 8px;color:#333\">Summary</h3>\n<p style=\"margin:0 0 20px;color:#555\">{{ summary }}</p>\n{% endif %}\n\n<a href=\"{{ interaction_url }}\" style=\"display:inline-block;padding:10px 20px;background:#F55F04;color:#fff;text-decoration:none;border-radius:6px;font-weight:600\">View Interaction</a>",
     "description": "Detailed classification breakdown for an interaction.",
     "is_system": true,
     "is_active": true,
     "created_at": "2026-10-22T08:21:52.467212Z",
     "updated_at": null
    },
    {
     "id": "d7df77c4-533d-48e4-9ca7-24f5f823b3a7",
     "name": "General Notification",
     "subject_template": "Notification: {{ agent_name }} - {{ interaction_title }}",
     "body_template": "<h2 style=\"margin:0 0 16px;color:#333\">Interaction Notification</h2>\n\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600;width:140px\">Agent</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ agent_name }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Interaction</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ interaction_title }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Type</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ source_type | title }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">Score</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\"><strong>{{ overall_score }}/100</strong></td>\n  </tr>\n</table>\n\n{% if summary %}\n<p style=\"margin:0 0 20px;color:#555\">{{ summary }}</p>\n{% endif %}\n\n<a href=\"{{ interaction_url }}\" style=\"display:inline-block;padding:10px 20px;background:#F55F04;color:#fff;text-decoration:none;border-radius:6px;font-weight:600\">View Interaction</a>",
     "description": "Clean, minimal template for manual sends or custom rules.",
     "is_system": true,
     "is_active": true,
     "created_at": "2026-10-22T08:21:52.467212Z",
     "updated_at": null
    },
    {
     "id": "a1bc70fc-274e-44e2-bccd-4d54ce5ab07a",
     "name": "QA Review Shared",
     "subject_template": "QA review: {{ interaction_title }} — {{ qa_score }}/100",
     "body_template": "<h2 style=\"margin:0 0 6px;font-size:18px;color:#111\">Your call was reviewed by QA</h2>\n<p style=\"margin:0 0 16px;color:#555\">{{ qa_reviewer_name }} reviewed <strong>{{ interaction_title }}</strong> on {{ qa_reviewed_at }}.</p>\n\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px\">\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600;width:140px\">QA score</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\"><strong>{{ qa_score }}/100</strong> <span style=\"color:#666\">{{ qa_score_change_text }}</span></td>\n  </tr>\n  <tr>\n    <td style=\"padding:8px 12px;background:#F9FAFB;border:1px solid #E5E7EB;font-weight:600\">AI score</td>\n    <td style=\"padding:8px 12px;border:1px solid #E5E7EB\">{{ ai_score }}/100</td>\n  </tr>\n</table>\n\n{% if qa_fatal %}\n<div style=\"background:#FEE2E2;border-left:4px solid #DC2626;padding:12px 16px;border-radius:8px;margin-bottom:20px;color:#991B1B\">\n  The QA marked this call fatal{% if qa_fatal_reason %}: {{ qa_fatal_reason }}{% endif %}\n</div>\n{% endif %}\n\n{% if qa_parameters %}\n<h3 style=\"margin:0 0 8px;font-size:15px;color:#111\">What the QA said</h3>\n<table style=\"width:100%;border-collapse:collapse;margin-bottom:20px;font-size:13px\">\n  <tr>\n    <th style=\"text-align:left;padding:6px 10px;background:#F9FAFB;border:1px solid #E5E7EB\">Parameter</th>\n    <th style=\"text-align:left;padding:6px 10px;background:#F9FAFB;border:1px solid #E5E7EB\">AI</th>\n    <th style=\"text-align:left;padding:6px 10px;background:#F9FAFB;border:1px solid #E5E7EB\">QA</th>\n    <th style=\"text-align:left;padding:6px 10px;background:#F9FAFB;border:1px solid #E5E7EB\">Comment</th>\n  </tr>\n  {% for p in qa_parameters %}\n  <tr>\n    <td style=\"padding:6px 10px;border:1px solid #E5E7EB\">{{ p.parameter }}</td>\n    <td style=\"padding:6px 10px;border:1px solid #E5E7EB\">{{ p.ai_rating }}</td>\n    <td style=\"padding:6px 10px;border:1px solid #E5E7EB;font-weight:600\">{{ p.qa_rating }}</td>\n    <td style=\"padding:6px 10px;border:1px solid #E5E7EB;color:#444\">{{ p.comment }}</td>\n  </tr>\n  {% endfor %}\n</table>\n{% endif %}\n\n<a href=\"{{ interaction_url }}\" style=\"display:inline-block;padding:10px 20px;background:#F55F04;color:#fff;text-decoration:none;border-radius:6px;font-weight:600\">View the call</a>",
     "description": "Tells the agent a QA reviewed their call: the QA's score against the AI's and the QA's comments. Use with a \"When a QA reviews a call\" trigger.",
     "is_system": true,
     "is_active": true,
     "created_at": "2026-10-22T08:21:52.467212Z",
     "updated_at": null
    }
   ]
  },
